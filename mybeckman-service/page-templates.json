{
  "metadata": {
    "projectType": "xwalk"
  },
  "templates": [
    {
      "name": "mybeckman-service",
      "urls": [
        "https://www.mybeckman.in/service"
      ],
      "representativeUrl": "https://www.mybeckman.in/service",
      "description": "mybeckman.in service hub page (exact match: photo hero, stats band, service cards, Get in Touch band)",
      "urlPattern": "/service",
      "siteOrigin": "https://www.mybeckman.in",
      "pathMap": {
        "/service": "/en-in/service",
        "/service/plans": "/en-in/service/plans",
        "": "/en-in/index",
        "/": "/en-in/",
        "/service/plans/centrifuge": "/en-in/service/plans/centrifuge",
        "/service/plans/flow-cytometry": "/en-in/service/plans/flow-cytometry",
        "/service/tech-support": "/en-in/service/tech-support",
        "/service/plans/liquid-handling": "/en-in/service/plans/liquid-handling",
        "/service/plans/particle-analysis": "/en-in/service/plans/particle-analysis"
      },
      "metaOverrides": {
        "/service": {
          "description": "Comprehensive service plans, remote connectivity, instrument optimization, repairs, technical support and qualification & calibration from Beckman Coulter Life Sciences.",
          "image": "https://media.beckman.com/-/media/service/media/service_hub_home-2022-09.jpg",
          "theme": "theme-mybeckman, mybeckman-inner"
        }
      },
      "blocks": [
        {
          "name": "hero-dim-photo",
          "instances": [
            "#main .bc-rich-text > .hero",
            "#main .hero"
          ]
        },
        {
          "name": "cards-stats",
          "instances": [
            "#main .Section--blue .Section__intro",
            "#main .Section__intro"
          ]
        },
        {
          "name": "cards-icon-border",
          "instances": [
            "#main .ServiceCards"
          ]
        },
        {
          "name": "cards-button-caption",
          "instances": [
            "#getInTouch .Contact__body",
            "#main .Contact__body"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Service-hub photo hero",
          "selector": [
            "#main .bc-rich-text:has(> .hero)",
            "#main .bc-rich-text:nth-of-type(1)"
          ],
          "style": null,
          "blocks": [
            "hero-dim-photo"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "Stats band",
          "selector": [
            "#main .bc-rich-text:has(.Section__intro)",
            "#main .bc-rich-text:nth-of-type(2)"
          ],
          "style": "blue",
          "blocks": [
            "cards-stats"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "Service cards",
          "selector": [
            "#main .bc-rich-text:has(.ServiceCards)",
            "#main .bc-rich-text:nth-of-type(3)"
          ],
          "style": null,
          "blocks": [
            "cards-icon-border"
          ],
          "defaultContent": []
        },
        {
          "id": "section-4",
          "name": "Get in Touch band",
          "selector": [
            "#getInTouch"
          ],
          "style": "blue, centered",
          "blocks": [
            "cards-button-caption"
          ],
          "defaultContent": [
            "#getInTouch .Contact > h2",
            "#getInTouch .Contact > p"
          ]
        }
      ],
      "site": "mybeckman"
    }
  ]
}
