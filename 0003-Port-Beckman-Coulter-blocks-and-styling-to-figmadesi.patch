diff --git a/blocks/site-footer/site-footer.js b/blocks/site-footer/site-footer.js
new file mode 100644
index 0000000..457b229
--- /dev/null
+++ b/blocks/site-footer/site-footer.js
@@ -0,0 +1,45 @@
+/**
+ * Standalone site-footer block (Beckman Coulter).
+ * Simple block — three fields, one cell per row:
+ *   row 1: brand   (wordmark + description)
+ *   row 2: columns (rich content: one heading + list per link column)
+ *   row 3: legal   (copyright)
+ *
+ * The columns cell holds consecutive "heading + list" pairs; each pair is
+ * grouped into its own column element for the grid layout.
+ */
+export default function decorate(block) {
+  // each row wraps content in a single cell <div>; unwrap to that cell
+  const cell = (row) => (row && row.children.length === 1 && row.firstElementChild.tagName === 'DIV'
+    ? row.firstElementChild
+    : row);
+
+  const rows = [...block.children];
+  const [brandRow, columnsRow, legalRow] = rows;
+
+  if (brandRow) brandRow.classList.add('site-footer-brand');
+
+  if (columnsRow) {
+    columnsRow.classList.add('site-footer-columns');
+    const src = cell(columnsRow);
+
+    // group each heading (p containing strong, or h*) with the nodes that
+    // follow it (its list) into a single column element
+    const columns = [];
+    let current = null;
+    [...src.children].forEach((node) => {
+      const isHeading = /^H[1-6]$/.test(node.tagName)
+        || (node.tagName === 'P' && node.querySelector('strong'));
+      if (isHeading) {
+        current = document.createElement('div');
+        current.className = 'site-footer-col';
+        columns.push(current);
+      }
+      if (current) current.append(node);
+    });
+
+    if (columns.length) columnsRow.replaceChildren(...columns);
+  }
+
+  if (legalRow) legalRow.classList.add('site-footer-legal');
+}
