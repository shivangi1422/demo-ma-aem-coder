+  color: var(--col-eyebrow-orange);
+  font-size: 13px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.columns-reversed .col-eyebrow {
+  margin: 0 0 10px;
+  color: var(--col-eyebrow-blue);
+  font-size: 13px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+/* check / bullet lists */
+.columns-productspec ul,
+.columns-reversed ul {
+  margin: 20px 0;
+  padding: 0;
+  list-style: none;
+}
+
+.columns-productspec li,
+.columns-reversed li {
+  position: relative;
+  margin: 12px 0;
+  padding-left: 30px;
+  color: var(--col-heading);
+  font-size: var(--body-font-size-s);
+  font-weight: 600;
+  line-height: 1.4;
+}
+
+.columns-productspec li::before,
+.columns-reversed li::before {
+  content: '✓';
+  position: absolute;
+  left: 0;
+  top: 0;
+  color: var(--col-check);
+  font-weight: 700;
+}
+
+/* CTA buttons */
+.columns-productspec a.button,
+.columns-product a.button {
+  border-radius: 4px;
+  padding: 0.7em 1.8em;
+  font-weight: 700;
+  border-color: var(--col-cta-bg);
+  background-color: var(--col-cta-bg);
+  color: #fff;
+}
+
+.columns-productspec a.button:hover,
+.columns-product a.button:hover {
+  border-color: var(--col-cta-hover);
+  background-color: var(--col-cta-hover);
+  color: #fff;
+}
+
+/* outlined CTA (reversed block "View Specifications") */
+/* stylelint-disable-next-line no-descending-specificity */
+.columns-reversed a.button {
+  border-radius: 4px;
+  padding: 0.7em 1.8em;
+  font-weight: 600;
+  border-color: #c2c9d4;
+  background-color: transparent;
+  color: var(--col-heading);
+}
+
+.columns-reversed a.button:hover {
+  border-color: var(--col-heading);
+  background-color: #f2f4f7;
+  color: var(--col-heading);
+}
+
+/* stylelint-disable no-descending-specificity */
+.columns-productspec img,
+.columns-reversed img,
+.columns-product img {
+  border-radius: 8px;
+}
+/* stylelint-enable no-descending-specificity */
+
+/* ---------------------------------------------------------------------------
+   Variant: columns-productspec (block 6, "DxC 700 AU")
+   A tab bar row on top, then a 2-col text/image row.
+   The tab bar is the FIRST row (single cell holding a list of links).
+   --------------------------------------------------------------------------- */
+
+.columns-productspec > div:first-child {
+  display: block;
+  border-bottom: 1px solid #e2e6ec;
+  margin-bottom: 32px;
+}
+
+.columns-productspec > div:first-child ul {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 28px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.columns-productspec > div:first-child li {
+  margin: 0;
+  padding: 0 0 14px;
+  font-weight: 600;
+  color: var(--col-body);
+}
+
+.columns-productspec > div:first-child li::before {
+  content: none;
+}
+
+.columns-productspec > div:first-child li:nth-child(2) {
+  color: var(--col-eyebrow-blue);
+  border-bottom: 2px solid var(--col-eyebrow-blue);
+}
+
+/* ---------------------------------------------------------------------------
+   Variant: columns-reversed (block 7, "DxH 900") — image left, text right
+   --------------------------------------------------------------------------- */
+
+@media (width >= 900px) {
+  .columns-reversed > div > .columns-img-col {
+    order: 0;
+  }
+}
+
+/* ---------------------------------------------------------------------------
+   Variant: columns-product (block 11, "CytoFLEX") — text left, media right
+   with a strip of thumbnails under the main image.
+   --------------------------------------------------------------------------- */
+
+.columns-product .col-thumbs {
+  display: flex;
+  gap: 12px;
+  margin-top: 12px;
+}
+
+/* stylelint-disable-next-line no-descending-specificity */
+.columns-product .col-thumbs img {
+  width: auto;
+  flex: 1;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+}
+
+/* ---------------------------------------------------------------------------
+   Variant: columns-insights ("Latest Insights") — left intro, right stacked
+   insight entries (eyebrow + heading + body).
+   --------------------------------------------------------------------------- */
+
+.columns-insights {
+  --ins-eyebrow: #0f4bd1;
+  --ins-heading: #1a2340;
+  --ins-body: #5b6472;
+  --ins-cta: #ec6608;
+}
+
+.columns-insights h2 {
+  margin: 0 0 16px;
+  color: var(--ins-heading);
+  font-size: clamp(28px, 3vw, 36px);
+  font-weight: 700;
+}
+
+.columns-insights > div > div:first-child > p {
+  color: var(--ins-body);
+  font-size: var(--body-font-size-s);
+  line-height: 1.6;
+}
+
+/* stylelint-disable-next-line no-descending-specificity */
+.columns-insights a.button {
+  border-radius: 0;
+  border: 1px solid var(--ins-cta);
+  background: transparent;
+  color: var(--ins-cta);
+  font-weight: 700;
+}
+
+.columns-insights a.button:hover {
+  background: var(--ins-cta);
+  color: #fff;
+}
+
+/* the right cell holds a list of insight items */
+.columns-insights .insight {
+  padding: 20px 0;
+  border-bottom: 1px solid #e2e6ec;
+}
+
+.columns-insights .insight:first-child {
+  padding-top: 0;
+}
+
+.columns-insights .insight .eyebrow {
+  margin: 0 0 6px;
+  color: var(--ins-eyebrow);
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.columns-insights .insight h3 {
+  margin: 0 0 8px;
+  color: var(--ins-heading);
+  font-size: 20px;
+  font-weight: 700;
+  line-height: 1.25;
+}
+
+/* stylelint-disable-next-line no-descending-specificity */
+.columns-insights .insight p {
+  margin: 0;
+  color: var(--ins-body);
+  font-size: var(--body-font-size-xs);
+  line-height: 1.5;
+}
+
+/* Static form panels removed — the two forms are now real Adaptive Form
+   blocks (see the form-request / content-form section styles in
+   styles/lazy-styles.css). */
