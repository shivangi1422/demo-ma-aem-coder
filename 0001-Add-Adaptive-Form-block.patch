+  let form;
+  let afbForm;
+  if (formDef) {
+    ({ form, afbForm } = await setupForm(formDef, {
+      pathname,
+      block,
+      editMode: block.classList.contains('edit-mode'),
+    }));
+    container.replaceWith(form);
+  }
+  return { form, afbForm };
+}
