{
  "definitions": [
    {
      "title": "Tabs Workflow",
      "id": "tabs-workflow",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Tabs Workflow",
              "filter": "tabs-workflow"
            }
          }
        }
      }
    },
    {
      "title": "Workflow Stage",
      "id": "tabs-workflow-stage",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Workflow Stage",
              "model": "tabs-workflow-stage",
              "state": "stage"
            }
          }
        }
      }
    },
    {
      "title": "Workflow Step",
      "id": "tabs-workflow-step",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Workflow Step",
              "model": "tabs-workflow-step",
              "state": "step"
            }
          }
        }
      }
    },
    {
      "title": "Workflow Product",
      "id": "tabs-workflow-product",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Workflow Product",
              "model": "tabs-workflow-product"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "tabs-workflow-stage",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Stage title",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "description",
          "label": "Description (optional)",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "state",
          "label": "State",
          "value": "stage",
          "description": "Greyed-out stages are shown but cannot be selected. Steps and products below a stage (up to the next stage) belong to it.",
          "options": [
            {
              "name": "Clickable",
              "value": "stage"
            },
            {
              "name": "Greyed out (not clickable)",
              "value": "stage-inactive"
            }
          ]
        }
      ]
    },
    {
      "id": "tabs-workflow-step",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Step label",
          "value": "",
          "description": "Products list this exact label in their Steps field to light up for this step"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "state",
          "label": "State",
          "value": "step",
          "options": [
            {
              "name": "Clickable",
              "value": "step"
            },
            {
              "name": "Greyed out (not clickable)",
              "value": "step-inactive"
            }
          ]
        }
      ]
    },
    {
      "id": "tabs-workflow-product",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Product image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image alt (leave empty: the name names the link)",
          "value": ""
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "link",
          "label": "Product page"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "linkText",
          "label": "Product name",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "steps",
          "label": "Steps (comma-separated step labels this product lights up for)",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageHeight",
          "label": "Image height in px (optional, e.g. 90)",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "tabs-workflow",
      "components": [
        "tabs-workflow-stage",
        "tabs-workflow-step",
        "tabs-workflow-product"
      ]
    }
  ]
