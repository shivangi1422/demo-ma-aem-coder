{
  "metadata": {
    "projectType": "xwalk"
  },
  "templates": [
    {
      "name": "mybeckman-plans",
      "urls": [
        "https://www.mybeckman.in/service/plans"
      ],
      "representativeUrl": "https://www.mybeckman.in/service/plans",
      "description": "mybeckman.in service plans page (exact match)",
      "urlPattern": "/service/plans",
      "siteOrigin": "https://www.mybeckman.in",
      "pathMap": {
        "/service": "/en-in/service",
        "/service/plans": "/en-in/service/plans",
        "": "/en-in/index",
        "/": "/en-in/",
        "/service/plans/centrifuge": "/en-in/service/plans/centrifuge"
      },
      "metaOverrides": {
        "/service/plans": {
          "title": "Service Plans",
          "description": "Beckman Coulter Life Sciences service plans: priority response, certified parts and labor, technology updates and compliance support to minimize instrument downtime.",
          "image": "https://media.beckman.com/-/media/service/media/service_images_call_center.jpg",
          "theme": "theme-mybeckman, mybeckman-inner"
        }
      },
      "blocks": [
        {
          "name": "cards-benefit-check",
          "instances": [
            "#main .Intro__body"
          ]
        },
        {
          "name": "cards-product-plan",
          "instances": [
            "#main .productCards"
          ]
        },
        {
          "name": "columns-media-text",
          "instances": [
            "#main .Section__two-column"
          ]
        },
        {
          "name": "cards-button-caption",
          "instances": [
            "#getInTouch .Contact__body",
            "#main .Contact__body"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Page title + Get Help Now",
          "selector": [
            "#main .bc-test-layout > .block > .bc-rich-text:has(> .Section__header)"
          ],
          "style": "wide",
          "blocks": [],
          "defaultContent": [
            ".Section__header > h1",
            ".Section__header > h2",
            ".Section__header .callout > p",
            ".Section__header .callout > a"
          ]
        },
        {
          "id": "section-2",
          "name": "Why choose a service plan",
          "selector": [
            "#main .bc-test-layout > .block > .bc-rich-text:has(.Intro)"
          ],
          "style": "blue, split, wide",
          "blocks": [
            "cards-benefit-check"
          ],
          "defaultContent": [
            ".Intro__title > h2",
            ".Intro__title > p"
          ]
        },
        {
          "id": "section-3",
          "name": "Product Specific Service Plans",
          "selector": [
            "#main .bc-test-layout > .block > .bc-rich-text:has(.productCards)"
          ],
          "style": "wide",
          "blocks": [
            "cards-product-plan"
          ],
          "defaultContent": [
            ".Section:has(> .productCards) > h2"
          ]
        },
        {
          "id": "section-4",
          "name": "Count on our team of experts",
          "selector": [
            "#main .bc-test-layout > .block > .bc-rich-text:has(.Section__two-column-right > ul)"
          ],
          "style": "wide",
          "blocks": [
            "columns-media-text"
          ],
          "defaultContent": [
            ".Section:has(> .Section__two-column) > h2",
            ".Section:has(> .Section__two-column) > p"
          ]
        },
        {
          "id": "section-5",
          "name": "BeckmanConnect Remote Service",
          "selector": [
            "#main .bc-test-layout > .block > .bc-rich-text:has(.wistia_responsive_padding)"
          ],
          "style": "wide",
          "blocks": [
            "columns-media-text"
          ],
          "defaultContent": []
        },
        {
          "id": "section-6",
          "name": "Training",
          "selector": [
            "#main .bc-test-layout > .block > .bc-rich-text:has(.Section__two-column-left > img):has(.Section__two-column-right > h3)"
          ],
          "style": "wide",
          "blocks": [
            "columns-media-text"
          ],
          "defaultContent": []
        },
        {
          "id": "section-7",
          "name": "Get in Touch",
          "selector": [
            "#getInTouch"
          ],
          "style": "blue, centered, wide",
          "blocks": [
            "cards-button-caption"
          ],
          "defaultContent": [
            "#getInTouch .Contact > h2",
            "#getInTouch .Contact > p"
          ]
        }
      ],
      "site": "mybeckman"
    }
  ]
}
